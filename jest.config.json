{
    "moduleFileExtensions": ["js", "json", "jsx", "ts", "tsx", "node", "d.ts"],
    "moduleNameMapper": {
        "\\.(css|jpg|png|svg)$": "<rootDir>/node_modules/jest-css-modules",
        "nav-(.*)-style": "<rootDir>/node_modules/jest-css-modules",
        "@navikt/ds-css": "<rootDir>/node_modules/jest-css-modules",
        "\\.\\/userContent": "<rootDir>/node_modules/jest-css-modules",
        "\\.\\/systemsStyles": "<rootDir>/node_modules/jest-css-modules",
        "^\\.\\/header$": "<rootDir>/node_modules/jest-css-modules",
        "^app/(.*)": "<rootDir>/src/app/$1",
        "^@nais/apm$": "<rootDir>/node_modules/@nais/apm/dist/index.js",
        "^@nais/apm/react$": "<rootDir>/node_modules/@nais/apm/dist/react/ErrorBoundary.js",
        "^uuid$": "<rootDir>/node_modules/uuid/dist-node/index.js"
    },
    "setupFiles": ["<rootDir>/testSetup.js"],
    "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
    "testEnvironment": "jest-environment-jsdom",
    "testRegex": "(<rootDir>/test/.*|(\\.|/)(spec))\\.tsx?$",
    "transform": {
        "^.+\\.(?:[tj]sx?|mjs)$": "babel-jest"
    },
    "transformIgnorePatterns": [
        "<rootDir>.*(node_modules)(?!.*(nav|@nais/apm|uuid|react-intl|@formatjs|intl-messageformat|react-router|@remix-run|cookie-es).*).*$"
    ],
    "unmockedModulePathPatterns": ["<rootDir>/node_modules/react", "<rootDir>/node_modules/react-router"],
    "setupFilesAfterEnv": ["<rootDir>/src/test/testConfig.js"]
}
